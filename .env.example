# ollama 服务地址（默认本机）
OLLAMA_BASE_URL=http://localhost:11434

# 生成模型 & 嵌入模型
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# 语料与索引
DOCS_DIR=data/docs
INDEX_DIR=storage/index

# 切分参数（阶段2调优的对象）
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索条数
TOP_K=5

# ---- stage 2: retrieval mode ----
# vector | hybrid | hybrid+rerank
RETRIEVER_MODE=vector
RECALL_K=20
RRF_K=60
RERANK_MODEL=BAAI/bge-reranker-base

# 可选：LangSmith 追踪（去 smith.langchain.com 拿 key）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_key
# LANGSMITH_PROJECT=kb-qa
